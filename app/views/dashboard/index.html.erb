<% content_for :page_title, "Operations Dashboard" %>
<% content_for :page_crumb, "Intelixa · #{Time.current.strftime('%d %b %Y')}" %>

<div class="view-wrap dash">
  <header class="dash-hero">
    <div class="dash-hero-copy">
      <h1>
        Welcome back<% if current_user %>,
          <%= current_user.try(:full_name).presence || current_user.email.split("@").first.titleize %>
        <% end %>
      </h1>
      <p>Real-time operational health across inventory, warehouses, and job work.</p>
    </div>
    <% if @alerts_count.to_i.positive? %>
      <div class="dash-alert-chip">
        <span class="pill warn"><%= @alerts_count %> low stock</span>
      </div>
    <% end %>
  </header>

  <section class="kpi-grid" aria-label="Key metrics">
    <article class="kpi-card kpi-card--featured">
      <div class="kpi-label">Total Inventory Value</div>
      <div class="kpi-value"><%= number_to_currency(@inventory_value || 0, unit: "₹", precision: 0) %></div>
      <div class="kpi-foot">Excludes trading products</div>
    </article>
    <article class="kpi-card">
      <div class="kpi-label">Active Master Items</div>
      <div class="kpi-value"><%= number_with_delimiter(@active_items_count || 0) %></div>
    </article>
    <article class="kpi-card<%= ' kpi-card--warn' if @alerts_count.to_i.positive? %>">
      <div class="kpi-label">Low Stock Alerts</div>
      <div class="kpi-value kpi-value--warn"><%= @alerts_count || 0 %></div>
    </article>
    <article class="kpi-card<%= ' kpi-card--warn' if @pending_challans.to_i.positive? %>">
      <div class="kpi-label">Pending Job Work</div>
      <div class="kpi-value<%= ' kpi-value--warn' if @pending_challans.to_i.positive? %>"><%= @pending_challans || 0 %></div>
    </article>
  </section>

  <div class="dash-grid">
    <section class="dash-main">
      
      <!-- ⚠️ Needs Attention List -->
      <div class="card border-rose">
        <div class="card-head bg-rose-dim">
          <h3 class="text-rose">⚠️ NEEDS ATTENTION (<%= @needs_attention.size %>)</h3>
        </div>
        <div class="list-group">
          <% if @needs_attention.any? %>
            <% @needs_attention.each do |challan| %>
              <div class="list-item">
                <span class="text-rose font-bold">Overdue</span> &mdash; <%= challan.job_worker.process_type.upcase %> &middot; CH-<%= challan.id.to_s.rjust(4, '0') %>
                <a href="/motor_admin/data/job_work_challans/<%= challan.id %>" class="link-gold ml-auto">View</a>
              </div>
            <% end %>
          <% else %>
            <div class="list-item text-muted">All clear! No items need immediate attention.</div>
          <% end %>
        </div>
      </div>

      <!-- 📊 My Work Kanban -->
      <div class="card mt-4">
        <div class="card-head">
          <h3>My Work</h3>
          <div class="card-sub">Due today &middot; overdue &middot; in progress &middot; coming up</div>
        </div>
        <div class="card-body">
          
          <!-- Dynamic Status Pills -->
          <div class="status-pills">
            <span class="pill outline"><%= @kanban_today.size %> today</span>
            <span class="pill outline <%= 'warn' if @kanban_overdue.any? %>"><%= @kanban_overdue.size %> overdue</span>
            <span class="pill outline info"><%= @kanban_working.size %> active</span>
            <span class="pill outline"><%= @kanban_upcoming.size %> upcoming</span>
          </div>

          <!-- Kanban Grid -->
          <div class="kanban-board-wrapper mt-4">
            <div class="kanban-grid">
              
              <!-- Today Column -->
              <div class="kanban-col">
                <div class="kanban-header"><span>📅</span> Today</div>
                <div class="kanban-body <%= 'empty' if @kanban_today.empty? %>">
                  <% if @kanban_today.empty? %>No tasks due today<% end %>
                  <% @kanban_today.each do |challan| %>
                    <div class="kanban-card">
                      <div class="flex-between">
                        <strong><%= challan.job_worker.process_type %></strong>
                        <span class="text-xs font-bold text-gold">Today</span>
                      </div>
                      <div class="text-muted text-xs mt-1">CH-<%= challan.id.to_s.rjust(4, '0') %> &middot; <%= challan.job_worker.name.truncate(18) %></div>
                    </div>
                  <% end %>
                </div>
              </div>
              
              <!-- Overdue Column -->
              <div class="kanban-col">
                <div class="kanban-header"><span>🕒</span> Overdue</div>
                <div class="kanban-body <%= 'empty' if @kanban_overdue.empty? %>">
                  <% if @kanban_overdue.empty? %>All caught up!<% end %>
                  <% @kanban_overdue.each do |challan| %>
                    <% days_overdue = (Time.current.to_date - challan.expected_return_date.to_date).to_i %>
                    <div class="kanban-card border-rose">
                      <div class="flex-between">
                        <strong><%= challan.job_worker.process_type %></strong>
                        <span class="text-rose text-xs font-bold"><%= days_overdue %>d overdue</span>
                      </div>
                      <div class="text-muted text-xs mt-1">CH-<%= challan.id.to_s.rjust(4, '0') %> &middot; <%= challan.job_worker.name.truncate(18) %></div>
                      <div class="mt-2"><span class="pill warn min">High Priority</span></div>
                    </div>
                  <% end %>
                </div>
              </div>

              <!-- Working (Active/Pending) Column -->
              <div class="kanban-col">
                <div class="kanban-header"><span>🔄</span> Working</div>
                <div class="kanban-body <%= 'empty' if @kanban_working.empty? %>">
                  <% if @kanban_working.empty? %>No active tasks<% end %>
                  <% @kanban_working.each do |challan| %>
                    <div class="kanban-card">
                      <div class="flex-between">
                        <strong><%= challan.job_worker.process_type %></strong>
                        <span class="text-xs text-muted">In Progress</span>
                      </div>
                      <div class="text-muted text-xs mt-1">CH-<%= challan.id.to_s.rjust(4, '0') %> &middot; <%= challan.job_worker.name.truncate(18) %></div>
                    </div>
                  <% end %>
                </div>
              </div>

              <!-- Upcoming Column -->
              <div class="kanban-col">
                <div class="kanban-header"><span>⏳</span> Upcoming</div>
                <div class="kanban-body <%= 'empty' if @kanban_upcoming.empty? %>">
                  <% if @kanban_upcoming.empty? %>No upcoming tasks<% end %>
                  <% @kanban_upcoming.each do |challan| %>
                    <div class="kanban-card">
                      <div class="flex-between">
                        <strong><%= challan.job_worker.process_type %></strong>
                        <span class="text-xs"><%= challan.expected_return_date.strftime("%b %d") %></span>
                      </div>
                      <div class="text-muted text-xs mt-1">CH-<%= challan.id.to_s.rjust(4, '0') %> &middot; <%= challan.job_worker.name.truncate(18) %></div>
                    </div>
                  <% end %>
                </div>
              </div>
              
            </div>
          </div>

        </div>
      </div>
    </section>
    
    <aside class="dash-side">
      <% if @warehouse_breakdown.present? %>
        <div class="card">
          <div class="card-head">
            <div>
              <h3>Inventory by Warehouse</h3>
              <div class="card-sub">Valuation share by location</div>
            </div>
          </div>
          <div class="card-body">
            <div class="wh-bars">
              <% @warehouse_breakdown.each do |name, value| %>
                <% pct = @inventory_value.to_f.positive? ? (value / @inventory_value * 100).round(1) : 0 %>
                <div class="wh-bar-row">
                  <div class="wh-bar-meta">
                    <span class="wh-bar-name"><%= name %></span>
                    <span class="wh-bar-val"><%= number_to_currency(value, unit: "₹", precision: 0) %></span>
                  </div>
                  <div class="wh-bar-track" role="presentation">
                    <div class="wh-bar-fill" style="width: <%= pct %>%;"></div>
                  </div>
                  <span class="wh-bar-pct"><%= pct %>%</span>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <div class="card">
        <div class="card-head">
          <h3>Quick Navigation</h3>
        </div>
        <div class="card-body">
          <nav class="quick-links" aria-label="Module shortcuts">
            <%= link_to "Master Management", "/motor_admin/data/items", class: "quick-link" %>
            <%= link_to "Inventory Batches", "/motor_admin/data/inventory_batches", class: "quick-link" %>
            <%= link_to "Job Work Challans", "/motor_admin/data/job_work_challans", class: "quick-link" %>
            <%= link_to "Quality Inspections", "/motor_admin/data/quality_inspections", class: "quick-link" %>
          </nav>
        </div>
      </div>
    </aside>
  </div>
</div>